    "case": "upper",
    "primary_color": "#FFFFFF",
    "highlight_color": "#FFD400",
    "position": "lower_third_78pct",
    "font_weight": 800
  },
  "broll_every_seconds": 5,
  "screen_demo_share": 0.35,
  "music": {"level_db": -24},
  "sfx_on_cuts": false,
  "hook_rules": [
    "Speech starts at 0.0s; no greeting, intro or logo",
    "First sentence states the stakes or payoff; never bait the video cannot pay off",
    "Hook card on screen from frame 1: 4-7 words, top third, held 2-4s",
    "Use a number, a counting setup, a bold specific claim or a 'you could be at risk' line",
    "Look into the lens, eyes ~30% from top of frame"
  ],
  "structure": [
    {"beat": "hook", "start": 0, "end": 3},
    {"beat": "why_it_matters", "start": 3, "end": 9},
